# MiniCPM-o 4.5 video full-duplex is the product default (300 s sessions).
# Official public Gateway (the application uses this URL even if omitted):
YROBOT_REALTIME_URL=wss://minicpmo45.modelbest.cn/v1/realtime?mode=video
YROBOT_TLS_VERIFY=1
# Self-hosted example (enable TLS bypass only for a trusted LAN certificate):
#YROBOT_REALTIME_URL=wss://10.0.16.184:8006/v1/realtime?mode=video
#YROBOT_TLS_VERIFY=0

# Persona: ONE short line. It is appended after the trained system line —
# long free-form personas drift the model out of its duplex distribution.
#YROBOT_PERSONA=你是 Reachy，一个友好的桌面机器人，用对方的语言简短口语化地回复。

# Attach camera frames only with mode=video. For a deliberate voice-only
# fallback, set this to 0 and change the URL to mode=audio.
YROBOT_SEND_VIDEO=1

# Optional explicit override when the URL has no mode: audio or video.
#YROBOT_REALTIME_MODE=video

# Camera capture remains live while the robot speaks. Active frames publish at
# 1 fps; idle sends scene changes immediately plus a bounded heartbeat.
#YROBOT_FRAME_CAPTURE_PERIOD_S=1.0
#YROBOT_FRAME_IDLE_HEARTBEAT_S=3.0
#YROBOT_SCENE_CHANGE_THRESHOLD=0.04

# Video sessions rotate at the first quiet moment past either budget. YRobot
# carries a bounded assistant-side continuity hint into the next session.
#YROBOT_SESSION_BUDGET_S=280
#YROBOT_KV_BUDGET=7200

# 0..3; higher = stricter voice detection (2 works well next to motors).
#YROBOT_VAD_AGGRESSIVENESS=2

# Echo-aware barge-in has a high-confidence 140 ms path and a conservative
# 500 ms path. INFO diagnostics identify the selected path and evidence.
#YROBOT_BARGE_ECHO_SIMILARITY=0.75
#YROBOT_BARGE_UNEXPLAINED_DB=-42
#YROBOT_BARGE_CONFIRM_MS=500
#YROBOT_BARGE_FAST_CONFIRM_MS=140
#YROBOT_BARGE_FAST_ECHO_SIMILARITY=0.45
#YROBOT_BARGE_FAST_UNEXPLAINED_DB=-36

# MiniCPM-o 4.5 duplex advances on complete one-second inference units.
# Values other than 1000 are rejected rather than silently breaking turn-taking.
#YROBOT_CHUNK_MS=1000

# Optional PCM WAV reference voices. They are converted to 16 kHz mono float32
# and sent through the documented session.init voice fields.
#YROBOT_REF_AUDIO_PATH=/path/to/llm-reference.wav
#YROBOT_TTS_REF_AUDIO_PATH=/path/to/tts-reference.wav

# In video mode, append a restrained proactive-observation policy to the
# trained system prompt. Disable for a purely reactive assistant.
#YROBOT_PROACTIVE=1

# Daemon face-tracking blend weight, 0 disables (DoA-only gaze).
#YROBOT_HEAD_TRACKING_WEIGHT=0.4

# Optional location for settings saved by the Reachy Mini dashboard UI.
# Defaults to ~/.config/yrobot/settings.json. Explicit environment variables
# always take precedence over values saved through the UI.
#YROBOT_CONFIG_PATH=/home/pollen/.config/yrobot/settings.json
